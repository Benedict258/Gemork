{
  "name": "gemork",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first autonomous AI agent using Gemma 4",
  "workspaces": [
    "desktop-shell/src-tauri",
    "desktop-shell/src",
    "local-orchestrator",
    "connector-adapter-layer",
    "browser-extension",
    "cloud-bridge",
    "mobile-app"
  ],
  "scripts": {
    "dev:desktop": "cd desktop-shell && npm run tauri dev",
    "dev:orchestrator": "cd local-orchestrator && npm run dev",
    "dev:extension": "cd browser-extension && npm run dev",
    "build:desktop": "cd desktop-shell && npm run tauri build",
    "build:orchestrator": "cd local-orchestrator && npm run build",
    "build:extension": "cd browser-extension && npm run build",
    "test": "vitest run",
    "lint": "eslint local-orchestrator/src/ browser-extension/src/",
    "typecheck": "tsc --noEmit --project local-orchestrator/tsconfig.json",
    "ci": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "uuid": "14.0.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
